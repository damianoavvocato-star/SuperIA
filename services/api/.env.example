# SuperIA API environment template.
# Copy to .env for local development. NEVER commit real values.
# Staging/production must use a persistent PostgreSQL URL, not SQLite or /tmp.
SUPERIA_ENVIRONMENT=development
SUPERIA_FREE_ONLY=false
SUPERIA_DATABASE_URL=
SUPERIA_AUTH_DB=./data/superia-auth.sqlite3
SUPERIA_ROUTER_STATE_DB=
SUPERIA_PAIRING_CODE=
SUPERIA_PAIRING_EDGE_RATE_LIMIT_CONFIRMED=false
SUPERIA_ADMIN_TOKEN=
SUPERIA_CHAT_IDEMPOTENCY_KEY=

# Provider keys are server-side only. Keep every provider disabled until
# account terms, no-card status, hard-stop behavior, and free model IDs are verified.
SUPERIA_PROVIDER_GEMINI_APPROVED_FREE=false
SUPERIA_PROVIDER_GEMINI_NO_PAYMENT_METHOD=false
SUPERIA_PROVIDER_GEMINI_HARD_STOP=false
SUPERIA_PROVIDER_GEMINI_NO_FIAT_BILLING=false
SUPERIA_PROVIDER_GEMINI_DATA_POLICY_APPROVED=false
SUPERIA_PROVIDER_GEMINI_API_KEY=
SUPERIA_PROVIDER_GEMINI_MODEL=
SUPERIA_PROVIDER_GEMINI_FREE_MODEL_IDS=

SUPERIA_PROVIDER_GROQ_APPROVED_FREE=false
SUPERIA_PROVIDER_GROQ_NO_PAYMENT_METHOD=false
SUPERIA_PROVIDER_GROQ_HARD_STOP=false
SUPERIA_PROVIDER_GROQ_NO_FIAT_BILLING=false
SUPERIA_PROVIDER_GROQ_DATA_POLICY_APPROVED=false
SUPERIA_PROVIDER_GROQ_API_KEY=
SUPERIA_PROVIDER_GROQ_MODEL=
SUPERIA_PROVIDER_GROQ_FREE_MODEL_IDS=

SUPERIA_PROVIDER_OPENROUTER_APPROVED_FREE=false
SUPERIA_PROVIDER_OPENROUTER_NO_PAYMENT_METHOD=false
SUPERIA_PROVIDER_OPENROUTER_HARD_STOP=false
SUPERIA_PROVIDER_OPENROUTER_NO_FIAT_BILLING=false
SUPERIA_PROVIDER_OPENROUTER_DATA_POLICY_APPROVED=false
SUPERIA_PROVIDER_OPENROUTER_API_KEY=
SUPERIA_PROVIDER_OPENROUTER_MODEL=
SUPERIA_PROVIDER_OPENROUTER_FREE_MODEL_IDS=

SUPERIA_PROVIDER_CLOUDFLARE_APPROVED_FREE=false
SUPERIA_PROVIDER_CLOUDFLARE_NO_PAYMENT_METHOD=false
SUPERIA_PROVIDER_CLOUDFLARE_HARD_STOP=false
SUPERIA_PROVIDER_CLOUDFLARE_NO_FIAT_BILLING=false
SUPERIA_PROVIDER_CLOUDFLARE_DATA_POLICY_APPROVED=false
SUPERIA_PROVIDER_CLOUDFLARE_API_KEY=
SUPERIA_PROVIDER_CLOUDFLARE_ACCOUNT_ID=
SUPERIA_PROVIDER_CLOUDFLARE_MODEL=
SUPERIA_PROVIDER_CLOUDFLARE_FREE_MODEL_IDS=

SUPERIA_PROVIDER_SAMBANOVA_APPROVED_FREE=false
SUPERIA_PROVIDER_SAMBANOVA_NO_PAYMENT_METHOD=false
SUPERIA_PROVIDER_SAMBANOVA_HARD_STOP=false
SUPERIA_PROVIDER_SAMBANOVA_NO_FIAT_BILLING=false
SUPERIA_PROVIDER_SAMBANOVA_DATA_POLICY_APPROVED=false
SUPERIA_PROVIDER_SAMBANOVA_API_KEY=
SUPERIA_PROVIDER_SAMBANOVA_MODEL=
